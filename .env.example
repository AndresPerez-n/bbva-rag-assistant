# ---------------------------------------------------------------------------
# BBVA RAG Assistant — configuration
# Copy this file to `.env` and fill in the values. Everything is externalized
# here so no parameter is hard-coded (see README "Externalized configuration").
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# LLM_PROVIDER selects the generation backend via the LLM factory: "openai"
# (default) or "anthropic". The rest of the pipeline is provider-agnostic, so
# switching is a config change only.
LLM_PROVIDER=openai

# OpenAI (GPT) — required when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Model id is swappable without code changes. gpt-4o-mini is cheap for testing;
# use gpt-4o for higher answer quality.
LLM_MODEL=gpt-4o-mini

# Anthropic (Claude) — only required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Sampling
LLM_MAX_TOKENS=1024

# --- Embeddings (local, free) ----------------------------------------------
# Default: compact, reliable, English-first. RECOMMENDED for this Spanish site
# (better ranking) if your network can pull the ~470MB weights:
#   EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector database (Qdrant) ----------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bbva_web

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval --------------------------------------------------------------
TOP_K_RETRIEVAL=20
TOP_K_FINAL=6
SIMILARITY_THRESHOLD=0.35

# --- Reranker (bonus) -------------------------------------------------------
# When true, a local cross-encoder re-ranks the retrieved candidates before
# they are passed to the LLM. When false, a no-op pass-through is used.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Conversation history ---------------------------------------------------
# N previous messages kept in context per session id (configurable).
CONVERSATION_WINDOW=8
HISTORY_DB_PATH=./data/history.db

# --- Scraper ----------------------------------------------------------------
SCRAPE_START_URL=https://www.bbva.com.co/
SCRAPE_MAX_PAGES=40
SCRAPE_MAX_DEPTH=2
RAW_DATA_DIR=./data/raw
CLEAN_DATA_DIR=./data/clean

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
