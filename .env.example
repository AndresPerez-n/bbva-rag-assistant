# ---------------------------------------------------------------------------
# BBVA RAG Assistant — configuration
# Copy this file to `.env` and fill in the values. Everything is externalized
# here so no parameter is hard-coded (see README "Externalized configuration").
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# LLM_PROVIDER selects the generation backend via the LLM factory: "anthropic"
# (default) or "openai". The rest of the pipeline is provider-agnostic.
LLM_PROVIDER=anthropic

# Anthropic (Claude) — required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Model id is swappable without code changes. Default is Claude Opus 4.8.
# Cheaper option for high volume: claude-sonnet-5
LLM_MODEL=claude-opus-4-8

# OpenAI — only required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Sampling
LLM_MAX_TOKENS=1024

# --- Embeddings (local, free) ----------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector database (Qdrant) ----------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bbva_web

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval --------------------------------------------------------------
TOP_K_RETRIEVAL=20
TOP_K_FINAL=5
SIMILARITY_THRESHOLD=0.25

# --- Reranker (bonus) -------------------------------------------------------
# When true, a local cross-encoder re-ranks the retrieved candidates before
# they are passed to the LLM. When false, a no-op pass-through is used.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Conversation history ---------------------------------------------------
# N previous messages kept in context per session id (configurable).
CONVERSATION_WINDOW=8
HISTORY_DB_PATH=./data/history.db

# --- Scraper ----------------------------------------------------------------
SCRAPE_START_URL=https://www.bbva.com.co/
SCRAPE_MAX_PAGES=40
SCRAPE_MAX_DEPTH=2
RAW_DATA_DIR=./data/raw
CLEAN_DATA_DIR=./data/clean

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
